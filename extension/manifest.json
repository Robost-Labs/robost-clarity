{
    "manifest_version": 3,
    "name": "Robost Clarity",
    "description": "Enterprise Shadow AI Detection - Monitor LLM usage across your organization",
    "version": "1.0.0",
    "permissions": [
        "storage",
        "activeTab",
        "webRequest"
    ],
    "host_permissions": [
        "https://chatgpt.com/*",
        "https://*.openai.com/*",
        "https://claude.ai/*",
        "https://*.anthropic.com/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://*.canva.com/*",
        "https://deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://*.bing.com/chat*",
        "https://x.ai/*",
        "https://grok.x.ai/*",
        "https://deepl.com/*",
        "https://*.deepl.com/*",
        "https://grammarly.com/*",
        "https://*.grammarly.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*",
                "https://*.canva.com/*",
                "https://deepseek.com/*",
                "https://*.perplexity.ai/*",
                "https://copilot.microsoft.com/*",
                "https://x.ai/*",
                "https://*.deepl.com/*",
                "https://*.grammarly.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ]
}