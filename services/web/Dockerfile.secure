# Build Stage
FROM node:18-alpine as build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Accept build argument for API URL
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

RUN npm run build

# Production Stage
FROM nginx:alpine

# Copy built assets from build stage
COPY --from=build /app/build /usr/share/nginx/html

# Configure Nginx to listen on 8080 (Cloud Run default) and handle React Router (SPA)
RUN echo 'server { \
    listen 8080; \
    server_name localhost; \
    location / { \
    root /usr/share/nginx/html; \
    index index.html index.htm; \
    try_files $uri $uri/ /index.html; \
    } \
    }' > /etc/nginx/conf.d/default.conf

# Expose port 8080
EXPOSE 8080

# Run as non-root (Nginx alpine default is usually root, but can be configured)
# For strict security, we can use nginx inc image unprivileged, but for now we stick to standard alpine with 3000 port
# CMD ["nginx", "-g", "daemon off;"] is default
