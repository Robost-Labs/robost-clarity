# Robost Clarity - GCP Deployment Configuration
# Production environment variables and settings

# ==============================================
# GCP Project Configuration
# ==============================================
GCP_PROJECT_ID=thermal-cathode-477302-h1
GCP_REGION=me-central1

# ==============================================
# Cloud SQL (PostgreSQL) Configuration
# ==============================================
CLOUD_SQL_INSTANCE_NAME=robost-postgres
CLOUD_SQL_CONNECTION_NAME=${GCP_PROJECT_ID}:${GCP_REGION}:${CLOUD_SQL_INSTANCE_NAME}
POSTGRES_DB=robost_clarity
POSTGRES_USER=robost_user
# Set this securely via Secret Manager
# POSTGRES_PASSWORD=<use-secret-manager>

# ==============================================
# Cloud Run Services
# ==============================================
API_SERVICE_NAME=robost-api
WEB_SERVICE_NAME=robost-web
CONSUMER_SERVICE_NAME=robost-consumer

# ==============================================
# Domain Configuration
# ==============================================
DOMAIN=clarity.robostai.com
API_DOMAIN=api.clarity.robostai.com

# ==============================================
# Cloud Pub/Sub Configuration (Kafka Replacement)
# ==============================================
PUBSUB_TOPIC=llm-traffic-logs
PUBSUB_SUBSCRIPTION=robost-consumer-sub

# ==============================================
# Authentication & Security
# ==============================================
# Store these in Secret Manager!
# JWT_SECRET_KEY=<use-secret-manager>
# ENCRYPTION_KEY=<use-secret-manager>
JWT_EXPIRATION_HOURS=24

# ==============================================
# SSO Configuration (Store in Secret Manager)
# ==============================================
# GOOGLE_CLIENT_ID=<use-secret-manager>
# GOOGLE_CLIENT_SECRET=<use-secret-manager>
# MICROSOFT_CLIENT_ID=<use-secret-manager>
# MICROSOFT_CLIENT_SECRET=<use-secret-manager>

# ==============================================
# Alert Integrations (Store in Secret Manager)
# ==============================================
# SLACK_WEBHOOK_URL=<use-secret-manager>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<use-secret-manager>
# SMTP_PASSWORD=<use-secret-manager>

# ==============================================
# Monitoring & Logging
# ==============================================
ENABLE_CLOUD_TRACE=true
ENABLE_CLOUD_PROFILER=true
LOG_LEVEL=INFO
