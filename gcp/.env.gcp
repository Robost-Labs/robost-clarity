# Robost Clarity - GCP Deployment Configuration
# Production environment variables and settings

# ==============================================
# GCP Project Configuration
# ==============================================
GCP_PROJECT_ID=thermal-cathode-477302-h1
GCP_REGION=me-central1

# ==============================================
# Cloud SQL (PostgreSQL) Configuration
# ==============================================
CLOUD_SQL_INSTANCE_NAME=robost-postgres
CLOUD_SQL_CONNECTION_NAME=thermal-cathode-477302-h1:me-central1:robost-postgres
POSTGRES_DB=robost_clarity
POSTGRES_USER=robost_user
# Auto-generated secure password
DB_PASSWORD=robost_secure_db_pass_2025!

# ==============================================
# Cloud Run Services
# ==============================================
API_SERVICE_NAME=robost-api
WEB_SERVICE_NAME=robost-web
CONSUMER_SERVICE_NAME=robost-consumer

# ==============================================
# Domain Configuration
# ==============================================
DOMAIN=clarity.robostai.com
API_DOMAIN=api.clarity.robostai.com

# ==============================================
# Cloud Pub/Sub Configuration (Kafka Replacement)
# ==============================================
PUBSUB_TOPIC=llm-traffic-logs
PUBSUB_SUBSCRIPTION=robost-consumer-sub

# ==============================================
# Authentication & Security
# ==============================================
JWT_EXPIRATION_HOURS=24
